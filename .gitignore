# --- vendored tmux plugins (nested git repos; tpm restores them) ---
.config/tmux/plugins/

# --- unused tool configs (kept on disk, not tracked) ---
.config/alacritty/
.config/helix/
.config/spaceship/
.config/wezterm/
.config/lvim/

# --- cruft ---
.DS_Store
*.zwc
*.bak
*.swp
*~
zsh/.zsh_plugins.zsh
.config/kitty/current-font.conf
.config/kitty/current-theme.conf
.config/tmux/current-theme.conf
.config/oh-my-posh/current.omp.json
.config/oh-my-posh/current-theme.name
.config/oh-my-posh/current-shape.name
.config/fastfetch/config.jsonc
zsh/.zshrc.local
.config/git/current-theme.gitconfig
.config/zsh/current-theme.zsh
.config/zellij/themes/

# --- nvim: runtime state, not config ---
.config/nvim/.neoconf.json
.config/nvim/.luarc.json
.config/nvim/colors/dotfiles.lua

# --- never track: contains live OAuth tokens ---
.config/github-copilot/
