// destiny-islands — zellij colors. Copied to ~/.config/zellij/themes/dotfiles.kdl
// by `set-theme`, and zellij reloads that directory on its own.
// Always named `dotfiles`, the name config.kdl selects.
themes {
    dotfiles {
        text_unselected {
            base "#fbeed6"
            background "#0a2b2e"
            emphasis_0 "#ffc93c"
            emphasis_1 "#39c5bb"
            emphasis_2 "#7fd46a"
            emphasis_3 "#f6a6c1"
        }
        text_selected {
            base "#fbeed6"
            background "#205355"
            emphasis_0 "#ffc93c"
            emphasis_1 "#39c5bb"
            emphasis_2 "#7fd46a"
            emphasis_3 "#f6a6c1"
        }
        ribbon_unselected {
            base "#fbeed6"
            background "#205355"
            emphasis_0 "#ff7f6a"
            emphasis_1 "#ffc93c"
            emphasis_2 "#f6a6c1"
            emphasis_3 "#6ec6ff"
        }
        ribbon_selected {
            base "#0a2b2e"
            background "#39c5bb"
            emphasis_0 "#ff7f6a"
            emphasis_1 "#ffc93c"
            emphasis_2 "#f6a6c1"
            emphasis_3 "#6ec6ff"
        }
        table_title {
            base "#39c5bb"
            background "#0a2b2e"
            emphasis_0 "#ffc93c"
            emphasis_1 "#39c5bb"
            emphasis_2 "#7fd46a"
            emphasis_3 "#f6a6c1"
        }
        table_cell_unselected {
            base "#fbeed6"
            background "#0a2b2e"
            emphasis_0 "#ffc93c"
            emphasis_1 "#39c5bb"
            emphasis_2 "#7fd46a"
            emphasis_3 "#f6a6c1"
        }
        table_cell_selected {
            base "#fbeed6"
            background "#205355"
            emphasis_0 "#ffc93c"
            emphasis_1 "#39c5bb"
            emphasis_2 "#7fd46a"
            emphasis_3 "#f6a6c1"
        }
        list_unselected {
            base "#fbeed6"
            background "#0a2b2e"
            emphasis_0 "#ffc93c"
            emphasis_1 "#39c5bb"
            emphasis_2 "#7fd46a"
            emphasis_3 "#f6a6c1"
        }
        list_selected {
            base "#fbeed6"
            background "#205355"
            emphasis_0 "#ffc93c"
            emphasis_1 "#39c5bb"
            emphasis_2 "#7fd46a"
            emphasis_3 "#f6a6c1"
        }
        frame_unselected {
            base "#205355"
            emphasis_0 "#ffc93c"
            emphasis_1 "#6ec6ff"
            emphasis_2 "#f6a6c1"
            emphasis_3 "#7fd46a"
        }
        frame_selected {
            base "#39c5bb"
            emphasis_0 "#ffc93c"
            emphasis_1 "#6ec6ff"
            emphasis_2 "#f6a6c1"
            emphasis_3 "#7fd46a"
        }
        frame_highlight {
            base "#ffc93c"
            emphasis_0 "#f6a6c1"
            emphasis_1 "#39c5bb"
            emphasis_2 "#ffc93c"
            emphasis_3 "#ff7f6a"
        }
        exit_code_success {
            base "#7fd46a"
            emphasis_0 "#ffc93c"
            emphasis_1 "#6ec6ff"
            emphasis_2 "#f6a6c1"
            emphasis_3 "#7fd46a"
        }
        exit_code_error {
            base "#ff7f6a"
            emphasis_0 "#ffc93c"
            emphasis_1 "#6ec6ff"
            emphasis_2 "#f6a6c1"
            emphasis_3 "#7fd46a"
        }
        multiplayer_user_colors {
            player_1 "#39c5bb"
            player_2 "#6ec6ff"
            player_3 "#f6a6c1"
            player_4 "#ffc93c"
            player_5 "#7fd46a"
            player_6 "#ff7f6a"
            player_7 "#39c5bb"
            player_8 "#6ec6ff"
            player_9 "#f6a6c1"
            player_10 "#ffc93c"
        }
    }
}
