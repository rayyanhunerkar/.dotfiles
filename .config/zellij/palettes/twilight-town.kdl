// twilight-town — zellij colors. Copied to ~/.config/zellij/themes/dotfiles.kdl
// by `set-theme`, and zellij reloads that directory on its own.
// Always named `dotfiles`, the name config.kdl selects.
themes {
    dotfiles {
        text_unselected {
            base "#ffe4c4"
            background "#1a1220"
            emphasis_0 "#ffc857"
            emphasis_1 "#4fd6be"
            emphasis_2 "#a8d96b"
            emphasis_3 "#ff9e4f"
        }
        text_selected {
            base "#ffe4c4"
            background "#3a2c47"
            emphasis_0 "#ffc857"
            emphasis_1 "#4fd6be"
            emphasis_2 "#a8d96b"
            emphasis_3 "#ff9e4f"
        }
        ribbon_unselected {
            base "#ffe4c4"
            background "#3a2c47"
            emphasis_0 "#ff7a7a"
            emphasis_1 "#ffc857"
            emphasis_2 "#ff9e4f"
            emphasis_3 "#c98fd8"
        }
        ribbon_selected {
            base "#1a1220"
            background "#4fd6be"
            emphasis_0 "#ff7a7a"
            emphasis_1 "#ffc857"
            emphasis_2 "#ff9e4f"
            emphasis_3 "#c98fd8"
        }
        table_title {
            base "#4fd6be"
            background "#1a1220"
            emphasis_0 "#ffc857"
            emphasis_1 "#4fd6be"
            emphasis_2 "#a8d96b"
            emphasis_3 "#ff9e4f"
        }
        table_cell_unselected {
            base "#ffe4c4"
            background "#1a1220"
            emphasis_0 "#ffc857"
            emphasis_1 "#4fd6be"
            emphasis_2 "#a8d96b"
            emphasis_3 "#ff9e4f"
        }
        table_cell_selected {
            base "#ffe4c4"
            background "#3a2c47"
            emphasis_0 "#ffc857"
            emphasis_1 "#4fd6be"
            emphasis_2 "#a8d96b"
            emphasis_3 "#ff9e4f"
        }
        list_unselected {
            base "#ffe4c4"
            background "#1a1220"
            emphasis_0 "#ffc857"
            emphasis_1 "#4fd6be"
            emphasis_2 "#a8d96b"
            emphasis_3 "#ff9e4f"
        }
        list_selected {
            base "#ffe4c4"
            background "#3a2c47"
            emphasis_0 "#ffc857"
            emphasis_1 "#4fd6be"
            emphasis_2 "#a8d96b"
            emphasis_3 "#ff9e4f"
        }
        frame_unselected {
            base "#3a2c47"
            emphasis_0 "#ffc857"
            emphasis_1 "#c98fd8"
            emphasis_2 "#ff9e4f"
            emphasis_3 "#a8d96b"
        }
        frame_selected {
            base "#4fd6be"
            emphasis_0 "#ffc857"
            emphasis_1 "#c98fd8"
            emphasis_2 "#ff9e4f"
            emphasis_3 "#a8d96b"
        }
        frame_highlight {
            base "#ffc857"
            emphasis_0 "#ff9e4f"
            emphasis_1 "#4fd6be"
            emphasis_2 "#ffc857"
            emphasis_3 "#ff7a7a"
        }
        exit_code_success {
            base "#a8d96b"
            emphasis_0 "#ffc857"
            emphasis_1 "#c98fd8"
            emphasis_2 "#ff9e4f"
            emphasis_3 "#a8d96b"
        }
        exit_code_error {
            base "#ff7a7a"
            emphasis_0 "#ffc857"
            emphasis_1 "#c98fd8"
            emphasis_2 "#ff9e4f"
            emphasis_3 "#a8d96b"
        }
        multiplayer_user_colors {
            player_1 "#4fd6be"
            player_2 "#c98fd8"
            player_3 "#ff9e4f"
            player_4 "#ffc857"
            player_5 "#a8d96b"
            player_6 "#ff7a7a"
            player_7 "#4fd6be"
            player_8 "#c98fd8"
            player_9 "#ff9e4f"
            player_10 "#ffc857"
        }
    }
}
