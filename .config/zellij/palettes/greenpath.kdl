// greenpath — zellij colors. Copied to ~/.config/zellij/themes/dotfiles.kdl
// by `set-theme`, and zellij reloads that directory on its own.
// Always named `dotfiles`, the name config.kdl selects.
themes {
    dotfiles {
        text_unselected {
            base "#e3efe2"
            background "#0b1410"
            emphasis_0 "#e0b64f"
            emphasis_1 "#8fcf6e"
            emphasis_2 "#57c7a0"
            emphasis_3 "#b08fc7"
        }
        text_selected {
            base "#e3efe2"
            background "#26392d"
            emphasis_0 "#e0b64f"
            emphasis_1 "#8fcf6e"
            emphasis_2 "#57c7a0"
            emphasis_3 "#b08fc7"
        }
        ribbon_unselected {
            base "#e3efe2"
            background "#26392d"
            emphasis_0 "#d9625a"
            emphasis_1 "#e0b64f"
            emphasis_2 "#b08fc7"
            emphasis_3 "#5fa8c4"
        }
        ribbon_selected {
            base "#0b1410"
            background "#8fcf6e"
            emphasis_0 "#d9625a"
            emphasis_1 "#e0b64f"
            emphasis_2 "#b08fc7"
            emphasis_3 "#5fa8c4"
        }
        table_title {
            base "#8fcf6e"
            background "#0b1410"
            emphasis_0 "#e0b64f"
            emphasis_1 "#8fcf6e"
            emphasis_2 "#57c7a0"
            emphasis_3 "#b08fc7"
        }
        table_cell_unselected {
            base "#e3efe2"
            background "#0b1410"
            emphasis_0 "#e0b64f"
            emphasis_1 "#8fcf6e"
            emphasis_2 "#57c7a0"
            emphasis_3 "#b08fc7"
        }
        table_cell_selected {
            base "#e3efe2"
            background "#26392d"
            emphasis_0 "#e0b64f"
            emphasis_1 "#8fcf6e"
            emphasis_2 "#57c7a0"
            emphasis_3 "#b08fc7"
        }
        list_unselected {
            base "#e3efe2"
            background "#0b1410"
            emphasis_0 "#e0b64f"
            emphasis_1 "#8fcf6e"
            emphasis_2 "#57c7a0"
            emphasis_3 "#b08fc7"
        }
        list_selected {
            base "#e3efe2"
            background "#26392d"
            emphasis_0 "#e0b64f"
            emphasis_1 "#8fcf6e"
            emphasis_2 "#57c7a0"
            emphasis_3 "#b08fc7"
        }
        frame_unselected {
            base "#26392d"
            emphasis_0 "#e0b64f"
            emphasis_1 "#5fa8c4"
            emphasis_2 "#b08fc7"
            emphasis_3 "#57c7a0"
        }
        frame_selected {
            base "#8fcf6e"
            emphasis_0 "#e0b64f"
            emphasis_1 "#5fa8c4"
            emphasis_2 "#b08fc7"
            emphasis_3 "#57c7a0"
        }
        frame_highlight {
            base "#e0b64f"
            emphasis_0 "#b08fc7"
            emphasis_1 "#8fcf6e"
            emphasis_2 "#e0b64f"
            emphasis_3 "#d9625a"
        }
        exit_code_success {
            base "#57c7a0"
            emphasis_0 "#e0b64f"
            emphasis_1 "#5fa8c4"
            emphasis_2 "#b08fc7"
            emphasis_3 "#57c7a0"
        }
        exit_code_error {
            base "#d9625a"
            emphasis_0 "#e0b64f"
            emphasis_1 "#5fa8c4"
            emphasis_2 "#b08fc7"
            emphasis_3 "#57c7a0"
        }
        multiplayer_user_colors {
            player_1 "#8fcf6e"
            player_2 "#5fa8c4"
            player_3 "#b08fc7"
            player_4 "#e0b64f"
            player_5 "#57c7a0"
            player_6 "#d9625a"
            player_7 "#8fcf6e"
            player_8 "#5fa8c4"
            player_9 "#b08fc7"
            player_10 "#e0b64f"
        }
    }
}
