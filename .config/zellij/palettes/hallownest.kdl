// hallownest — zellij colors. Copied to ~/.config/zellij/themes/dotfiles.kdl
// by `set-theme`, and zellij reloads that directory on its own.
// Always named `dotfiles`, the name config.kdl selects.
themes {
    dotfiles {
        text_unselected {
            base "#e9edf2"
            background "#0c0e14"
            emphasis_0 "#f08a3c"
            emphasis_1 "#6fa3d8"
            emphasis_2 "#7fb88a"
            emphasis_3 "#a48fd0"
        }
        text_selected {
            base "#e9edf2"
            background "#2a3040"
            emphasis_0 "#f08a3c"
            emphasis_1 "#6fa3d8"
            emphasis_2 "#7fb88a"
            emphasis_3 "#a48fd0"
        }
        ribbon_unselected {
            base "#e9edf2"
            background "#2a3040"
            emphasis_0 "#d8524f"
            emphasis_1 "#f08a3c"
            emphasis_2 "#a48fd0"
            emphasis_3 "#8fe3dc"
        }
        ribbon_selected {
            base "#0c0e14"
            background "#6fa3d8"
            emphasis_0 "#d8524f"
            emphasis_1 "#f08a3c"
            emphasis_2 "#a48fd0"
            emphasis_3 "#8fe3dc"
        }
        table_title {
            base "#6fa3d8"
            background "#0c0e14"
            emphasis_0 "#f08a3c"
            emphasis_1 "#6fa3d8"
            emphasis_2 "#7fb88a"
            emphasis_3 "#a48fd0"
        }
        table_cell_unselected {
            base "#e9edf2"
            background "#0c0e14"
            emphasis_0 "#f08a3c"
            emphasis_1 "#6fa3d8"
            emphasis_2 "#7fb88a"
            emphasis_3 "#a48fd0"
        }
        table_cell_selected {
            base "#e9edf2"
            background "#2a3040"
            emphasis_0 "#f08a3c"
            emphasis_1 "#6fa3d8"
            emphasis_2 "#7fb88a"
            emphasis_3 "#a48fd0"
        }
        list_unselected {
            base "#e9edf2"
            background "#0c0e14"
            emphasis_0 "#f08a3c"
            emphasis_1 "#6fa3d8"
            emphasis_2 "#7fb88a"
            emphasis_3 "#a48fd0"
        }
        list_selected {
            base "#e9edf2"
            background "#2a3040"
            emphasis_0 "#f08a3c"
            emphasis_1 "#6fa3d8"
            emphasis_2 "#7fb88a"
            emphasis_3 "#a48fd0"
        }
        frame_unselected {
            base "#2a3040"
            emphasis_0 "#f08a3c"
            emphasis_1 "#8fe3dc"
            emphasis_2 "#a48fd0"
            emphasis_3 "#7fb88a"
        }
        frame_selected {
            base "#6fa3d8"
            emphasis_0 "#f08a3c"
            emphasis_1 "#8fe3dc"
            emphasis_2 "#a48fd0"
            emphasis_3 "#7fb88a"
        }
        frame_highlight {
            base "#f08a3c"
            emphasis_0 "#a48fd0"
            emphasis_1 "#6fa3d8"
            emphasis_2 "#f08a3c"
            emphasis_3 "#d8524f"
        }
        exit_code_success {
            base "#7fb88a"
            emphasis_0 "#f08a3c"
            emphasis_1 "#8fe3dc"
            emphasis_2 "#a48fd0"
            emphasis_3 "#7fb88a"
        }
        exit_code_error {
            base "#d8524f"
            emphasis_0 "#f08a3c"
            emphasis_1 "#8fe3dc"
            emphasis_2 "#a48fd0"
            emphasis_3 "#7fb88a"
        }
        multiplayer_user_colors {
            player_1 "#6fa3d8"
            player_2 "#8fe3dc"
            player_3 "#a48fd0"
            player_4 "#f08a3c"
            player_5 "#7fb88a"
            player_6 "#d8524f"
            player_7 "#6fa3d8"
            player_8 "#8fe3dc"
            player_9 "#a48fd0"
            player_10 "#f08a3c"
        }
    }
}
