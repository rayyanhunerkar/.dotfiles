// Mirrors tmux.conf: everything sits behind prefix C-s, so apps keep their keys.
// clear-defaults because zellij's stock bindings take C-t (fzf), C-o, C-g, C-n
// and C-p from the shell and nvim.

// themes/dotfiles.kdl is gitignored; `set-theme` copies it from palettes/.
theme "dotfiles"

// Same as kitty's `tmux attach || tmux`: one named session, created once.
session_name "runner"
attach_to_session true

default_layout "compact"
pane_frames false
mouse_mode true
copy_command "pbcopy"
scroll_buffer_size 50000
session_serialization true
show_startup_tips false
show_release_notes false

keybinds clear-defaults=true {
    normal {
        bind "Ctrl s" { SwitchToMode "Tmux"; }
        bind "Alt h" { MoveFocus "Left"; }
        bind "Alt j" { MoveFocus "Down"; }
        bind "Alt k" { MoveFocus "Up"; }
        bind "Alt l" { MoveFocus "Right"; }
    }
    tmux {
        bind "Esc" { SwitchToMode "Normal"; }
        bind "Ctrl s" { Write 19; SwitchToMode "Normal"; }
        bind "v" { NewPane "Right"; SwitchToMode "Normal"; }
        bind "h" { NewPane "Down"; SwitchToMode "Normal"; }
        bind "z" { ToggleFocusFullscreen; SwitchToMode "Normal"; }
        bind "x" { CloseFocus; SwitchToMode "Normal"; }
        bind "c" { NewTab; SwitchToMode "Normal"; }
        bind "n" { GoToNextTab; SwitchToMode "Normal"; }
        bind "p" { GoToPreviousTab; SwitchToMode "Normal"; }
        bind "1" { GoToTab 1; SwitchToMode "Normal"; }
        bind "2" { GoToTab 2; SwitchToMode "Normal"; }
        bind "3" { GoToTab 3; SwitchToMode "Normal"; }
        bind "4" { GoToTab 4; SwitchToMode "Normal"; }
        bind "5" { GoToTab 5; SwitchToMode "Normal"; }
        bind "," { SwitchToMode "RenameTab"; TabNameInput 0; }
        bind "[" { SwitchToMode "Scroll"; }
        bind "d" { Detach; }
        bind "s" {
            LaunchOrFocusPlugin "session-manager" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "Normal"
        }
        // Stays in this mode so resizing repeats like `bind -r`; Esc leaves.
        bind "H" { Resize "Increase Left"; }
        bind "J" { Resize "Increase Down"; }
        bind "K" { Resize "Increase Up"; }
        bind "L" { Resize "Increase Right"; }
    }
    scroll {
        bind "Esc" "q" { SwitchToMode "Normal"; }
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "Ctrl d" { HalfPageScrollDown; }
        bind "Ctrl u" { HalfPageScrollUp; }
        bind "g" { ScrollToTop; }
        bind "G" { ScrollToBottom; }
    }
    renametab {
        bind "Enter" { SwitchToMode "Normal"; }
        bind "Esc" { UndoRenameTab; SwitchToMode "Normal"; }
    }
}
