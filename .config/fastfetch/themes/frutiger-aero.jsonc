{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "builtin",
        "source": "macos",
        "color": {
            "1": "#ffd93d", // sunlight
            "2": "#9d8df1", // glass violet
            "3": "#ff6b6b", // coral
            "4": "#4db8ff", // sky
            "5": "#2ee6d6"  // aqua
        },
        "padding": {
            "top": 3,
            "left": 3
        }
    },
    "display": {
        "separator": ": ",
        "color": {
            "separator": "#5f96aa"
        }
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;2;77;184;255m┌──────────────────────\u001b[38;2;255;217;61mHardware\u001b[38;2;77;184;255m──────────────────────┐"
        },
        {
            "type": "host",
            "key": " PC",
            "keyColor": "#4db8ff"
        },
        {
            "type": "cpu",
            "key": "│ ├",
            "keyColor": "#4db8ff"
        },
        {
            "type": "gpu",
            "key": "│ ├󰍛",
            "keyColor": "#4db8ff"
        },
        {
            "type": "memory",
            "key": "│ ├󰍛",
            "keyColor": "#4db8ff"
        },
        {
            "type": "disk",
            "key": "└ └",
            "keyColor": "#4db8ff",
            "folders": "/"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;77;184;255m└────────────────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;2;46;230;214m┌──────────────────────\u001b[38;2;255;217;61mSoftware\u001b[38;2;46;230;214m──────────────────────┐"
        },
        {
            "type": "os",
            "key": " OS",
            "keyColor": "#2ee6d6"
        },
        {
            "type": "kernel",
            "key": "│ ├",
            "keyColor": "#2ee6d6"
        },
        {
            "type": "packages",
            "key": "│ ├󰏖",
            "keyColor": "#2ee6d6"
        },
        {
            "type": "shell",
            "key": "└ └",
            "keyColor": "#2ee6d6"
        },
        "break",
        {
            "type": "wm",
            "key": " WM",
            "keyColor": "#9d8df1"
        },
        {
            "type": "wmtheme",
            "key": "│ ├󰉼",
            "keyColor": "#9d8df1"
        },
        {
            "type": "terminal",
            "key": "└ └",
            "keyColor": "#9d8df1"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;46;230;214m└────────────────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;2;255;217;61m┌──────────────────\u001b[38;2;46;230;214mUptime / Age / DT\u001b[38;2;255;217;61m─────────────────┐"
        },
        {
            "type": "command",
            "key": " 󰃭 OS Age ",
            "keyColor": "#ffd93d",
            "text": "birth=$(stat -f %B / 2>/dev/null || stat -c %W / 2>/dev/null); now=$(date +%s); echo $(( (now - birth) / 86400 )) days"
        },
        {
            "type": "uptime",
            "key": "  Uptime ",
            "keyColor": "#ffd93d"
        },
        {
            "type": "datetime",
            "key": "  DateTime ",
            "keyColor": "#ffd93d"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;255;217;61m└────────────────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        },
        "break"
    ]
}
