{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "builtin",
        "source": "macos",
        "color": {
            "1": "#eeb04a", // candle
            "2": "#a77fd1", // soul
            "3": "#ff7a66", // ember
            "4": "#7fa6d6", // moon
            "5": "#e8455a"  // blood
        },
        "padding": {
            "top": 3,
            "left": 3
        }
    },
    "display": {
        "separator": ": ",
        "color": {
            "separator": "#8f7482"
        }
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;2;127;166;214m┌──────────────────────\u001b[38;2;238;176;74mHardware\u001b[38;2;127;166;214m──────────────────────┐"
        },
        {
            "type": "host",
            "key": " PC",
            "keyColor": "#7fa6d6"
        },
        {
            "type": "cpu",
            "key": "│ ├",
            "keyColor": "#7fa6d6"
        },
        {
            "type": "gpu",
            "key": "│ ├󰍛",
            "keyColor": "#7fa6d6"
        },
        {
            "type": "memory",
            "key": "│ ├󰍛",
            "keyColor": "#7fa6d6"
        },
        {
            "type": "disk",
            "key": "└ └",
            "keyColor": "#7fa6d6",
            "folders": "/"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;127;166;214m└────────────────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;2;232;69;90m┌──────────────────────\u001b[38;2;238;176;74mSoftware\u001b[38;2;232;69;90m──────────────────────┐"
        },
        {
            "type": "os",
            "key": " OS",
            "keyColor": "#e8455a"
        },
        {
            "type": "kernel",
            "key": "│ ├",
            "keyColor": "#e8455a"
        },
        {
            "type": "packages",
            "key": "│ ├󰏖",
            "keyColor": "#e8455a"
        },
        {
            "type": "shell",
            "key": "└ └",
            "keyColor": "#e8455a"
        },
        "break",
        {
            "type": "wm",
            "key": " WM",
            "keyColor": "#a77fd1"
        },
        {
            "type": "wmtheme",
            "key": "│ ├󰉼",
            "keyColor": "#a77fd1"
        },
        {
            "type": "terminal",
            "key": "└ └",
            "keyColor": "#a77fd1"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;232;69;90m└────────────────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;2;238;176;74m┌──────────────────\u001b[38;2;232;69;90mUptime / Age / DT\u001b[38;2;238;176;74m─────────────────┐"
        },
        {
            "type": "command",
            "key": " 󰃭 OS Age ",
            "keyColor": "#eeb04a",
            "text": "birth=$(stat -f %B / 2>/dev/null || stat -c %W / 2>/dev/null); now=$(date +%s); echo $(( (now - birth) / 86400 )) days"
        },
        {
            "type": "uptime",
            "key": "  Uptime ",
            "keyColor": "#eeb04a"
        },
        {
            "type": "datetime",
            "key": "  DateTime ",
            "keyColor": "#eeb04a"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;238;176;74m└────────────────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        },
        "break"
    ]
}
