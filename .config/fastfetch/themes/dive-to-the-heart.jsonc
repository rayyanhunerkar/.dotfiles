{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "builtin",
        "source": "macos",
        "color": {
            "1": "#f2c14e", // crown gold
            "2": "#ff8fb2", // paopu pink
            "3": "#e0566b", // heartless red
            "4": "#4d7cff", // keyblade blue
            "5": "#35d0e0"  // dive glow
        },
        "padding": {
            "top": 3,
            "left": 3
        }
    },
    "display": {
        "separator": ": ",
        "color": {
            "separator": "#5a6699"
        }
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;2;77;124;255m┌──────────────────────\u001b[38;2;242;193;78mHardware\u001b[38;2;77;124;255m──────────────────────┐"
        },
        {
            "type": "host",
            "key": " PC",
            "keyColor": "#4d7cff"
        },
        {
            "type": "cpu",
            "key": "│ ├",
            "keyColor": "#4d7cff"
        },
        {
            "type": "gpu",
            "key": "│ ├󰍛",
            "keyColor": "#4d7cff"
        },
        {
            "type": "memory",
            "key": "│ ├󰍛",
            "keyColor": "#4d7cff"
        },
        {
            "type": "disk",
            "key": "└ └",
            "keyColor": "#4d7cff",
            "folders": "/"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;77;124;255m└────────────────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;2;53;208;224m┌──────────────────────\u001b[38;2;242;193;78mSoftware\u001b[38;2;53;208;224m──────────────────────┐"
        },
        {
            "type": "os",
            "key": " OS",
            "keyColor": "#35d0e0"
        },
        {
            "type": "kernel",
            "key": "│ ├",
            "keyColor": "#35d0e0"
        },
        {
            "type": "packages",
            "key": "│ ├󰏖",
            "keyColor": "#35d0e0"
        },
        {
            "type": "shell",
            "key": "└ └",
            "keyColor": "#35d0e0"
        },
        "break",
        {
            "type": "wm",
            "key": " WM",
            "keyColor": "#ff8fb2"
        },
        {
            "type": "wmtheme",
            "key": "│ ├󰉼",
            "keyColor": "#ff8fb2"
        },
        {
            "type": "terminal",
            "key": "└ └",
            "keyColor": "#ff8fb2"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;53;208;224m└────────────────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;2;242;193;78m┌──────────────────\u001b[38;2;53;208;224mUptime / Age / DT\u001b[38;2;242;193;78m─────────────────┐"
        },
        {
            "type": "command",
            "key": " 󰃭 OS Age ",
            "keyColor": "#f2c14e",
            "text": "birth=$(stat -f %B / 2>/dev/null || stat -c %W / 2>/dev/null); now=$(date +%s); echo $(( (now - birth) / 86400 )) days"
        },
        {
            "type": "uptime",
            "key": "  Uptime ",
            "keyColor": "#f2c14e"
        },
        {
            "type": "datetime",
            "key": "  DateTime ",
            "keyColor": "#f2c14e"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;242;193;78m└────────────────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        },
        "break"
    ]
}
