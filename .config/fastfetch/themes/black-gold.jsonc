{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "builtin",
        "source": "macos",
        "color": {
            "1": "#ff9f1c", // amber
            "2": "#dba392", // rose gold
            "3": "#e5484d", // garnet
            "4": "#f5d76e", // gilt
            "5": "#d4af37"  // gold
        },
        "padding": {
            "top": 3,
            "left": 3
        }
    },
    "display": {
        "separator": ": ",
        "color": {
            "separator": "#8a7a52"
        }
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;2;245;215;110m┌──────────────────────\u001b[38;2;255;159;28mHardware\u001b[38;2;245;215;110m──────────────────────┐"
        },
        {
            "type": "host",
            "key": " PC",
            "keyColor": "#f5d76e"
        },
        {
            "type": "cpu",
            "key": "│ ├",
            "keyColor": "#f5d76e"
        },
        {
            "type": "gpu",
            "key": "│ ├󰍛",
            "keyColor": "#f5d76e"
        },
        {
            "type": "memory",
            "key": "│ ├󰍛",
            "keyColor": "#f5d76e"
        },
        {
            "type": "disk",
            "key": "└ └",
            "keyColor": "#f5d76e",
            "folders": "/"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;245;215;110m└────────────────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;2;212;175;55m┌──────────────────────\u001b[38;2;255;159;28mSoftware\u001b[38;2;212;175;55m──────────────────────┐"
        },
        {
            "type": "os",
            "key": " OS",
            "keyColor": "#d4af37"
        },
        {
            "type": "kernel",
            "key": "│ ├",
            "keyColor": "#d4af37"
        },
        {
            "type": "packages",
            "key": "│ ├󰏖",
            "keyColor": "#d4af37"
        },
        {
            "type": "shell",
            "key": "└ └",
            "keyColor": "#d4af37"
        },
        "break",
        {
            "type": "wm",
            "key": " WM",
            "keyColor": "#dba392"
        },
        {
            "type": "wmtheme",
            "key": "│ ├󰉼",
            "keyColor": "#dba392"
        },
        {
            "type": "terminal",
            "key": "└ └",
            "keyColor": "#dba392"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;212;175;55m└────────────────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;2;255;159;28m┌──────────────────\u001b[38;2;212;175;55mUptime / Age / DT\u001b[38;2;255;159;28m─────────────────┐"
        },
        {
            "type": "command",
            "key": " 󰃭 OS Age ",
            "keyColor": "#ff9f1c",
            "text": "birth=$(stat -f %B / 2>/dev/null || stat -c %W / 2>/dev/null); now=$(date +%s); echo $(( (now - birth) / 86400 )) days"
        },
        {
            "type": "uptime",
            "key": "  Uptime ",
            "keyColor": "#ff9f1c"
        },
        {
            "type": "datetime",
            "key": "  DateTime ",
            "keyColor": "#ff9f1c"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;255;159;28m└────────────────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        },
        "break"
    ]
}
