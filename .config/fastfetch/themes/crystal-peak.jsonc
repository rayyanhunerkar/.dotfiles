{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "builtin",
        "source": "macos",
        "color": {
            "1": "#f2c078", // lantern
            "2": "#8fb4f0", // quartz
            "3": "#e8566f", // husk
            "4": "#84dcdc", // ice
            "5": "#f27fc0"  // crystal
        },
        "padding": {
            "top": 3,
            "left": 3
        }
    },
    "display": {
        "separator": ": ",
        "color": {
            "separator": "#85759a"
        }
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;2;132;220;220m┌──────────────────────\u001b[38;2;242;192;120mHardware\u001b[38;2;132;220;220m──────────────────────┐"
        },
        {
            "type": "host",
            "key": " PC",
            "keyColor": "#84dcdc"
        },
        {
            "type": "cpu",
            "key": "│ ├",
            "keyColor": "#84dcdc"
        },
        {
            "type": "gpu",
            "key": "│ ├󰍛",
            "keyColor": "#84dcdc"
        },
        {
            "type": "memory",
            "key": "│ ├󰍛",
            "keyColor": "#84dcdc"
        },
        {
            "type": "disk",
            "key": "└ └",
            "keyColor": "#84dcdc",
            "folders": "/"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;132;220;220m└────────────────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;2;242;127;192m┌──────────────────────\u001b[38;2;242;192;120mSoftware\u001b[38;2;242;127;192m──────────────────────┐"
        },
        {
            "type": "os",
            "key": " OS",
            "keyColor": "#f27fc0"
        },
        {
            "type": "kernel",
            "key": "│ ├",
            "keyColor": "#f27fc0"
        },
        {
            "type": "packages",
            "key": "│ ├󰏖",
            "keyColor": "#f27fc0"
        },
        {
            "type": "shell",
            "key": "└ └",
            "keyColor": "#f27fc0"
        },
        "break",
        {
            "type": "wm",
            "key": " WM",
            "keyColor": "#8fb4f0"
        },
        {
            "type": "wmtheme",
            "key": "│ ├󰉼",
            "keyColor": "#8fb4f0"
        },
        {
            "type": "terminal",
            "key": "└ └",
            "keyColor": "#8fb4f0"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;242;127;192m└────────────────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;2;242;192;120m┌──────────────────\u001b[38;2;242;127;192mUptime / Age / DT\u001b[38;2;242;192;120m─────────────────┐"
        },
        {
            "type": "command",
            "key": " 󰃭 OS Age ",
            "keyColor": "#f2c078",
            "text": "birth=$(stat -f %B / 2>/dev/null || stat -c %W / 2>/dev/null); now=$(date +%s); echo $(( (now - birth) / 86400 )) days"
        },
        {
            "type": "uptime",
            "key": "  Uptime ",
            "keyColor": "#f2c078"
        },
        {
            "type": "datetime",
            "key": "  DateTime ",
            "keyColor": "#f2c078"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;242;192;120m└────────────────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        },
        "break"
    ]
}
