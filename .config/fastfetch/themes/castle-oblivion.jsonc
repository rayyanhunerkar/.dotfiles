{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "builtin",
        "source": "macos",
        "color": {
            "1": "#e89aa2", // Marluxia rose
            "2": "#c49ab4", // mauve
            "3": "#f0787e", // alarm rose
            "4": "#a8bcd4", // slate
            "5": "#8fb89e"  // sage
        },
        "padding": {
            "top": 3,
            "left": 3
        }
    },
    "display": {
        "separator": ": ",
        "color": {
            "separator": "#9a9284"
        }
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;2;168;188;212m┌──────────────────────\u001b[38;2;232;154;162mHardware\u001b[38;2;168;188;212m──────────────────────┐"
        },
        {
            "type": "host",
            "key": " PC",
            "keyColor": "#a8bcd4"
        },
        {
            "type": "cpu",
            "key": "│ ├",
            "keyColor": "#a8bcd4"
        },
        {
            "type": "gpu",
            "key": "│ ├󰍛",
            "keyColor": "#a8bcd4"
        },
        {
            "type": "memory",
            "key": "│ ├󰍛",
            "keyColor": "#a8bcd4"
        },
        {
            "type": "disk",
            "key": "└ └",
            "keyColor": "#a8bcd4",
            "folders": "/"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;168;188;212m└────────────────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;2;143;184;158m┌──────────────────────\u001b[38;2;232;154;162mSoftware\u001b[38;2;143;184;158m──────────────────────┐"
        },
        {
            "type": "os",
            "key": " OS",
            "keyColor": "#8fb89e"
        },
        {
            "type": "kernel",
            "key": "│ ├",
            "keyColor": "#8fb89e"
        },
        {
            "type": "packages",
            "key": "│ ├󰏖",
            "keyColor": "#8fb89e"
        },
        {
            "type": "shell",
            "key": "└ └",
            "keyColor": "#8fb89e"
        },
        "break",
        {
            "type": "wm",
            "key": " WM",
            "keyColor": "#c49ab4"
        },
        {
            "type": "wmtheme",
            "key": "│ ├󰉼",
            "keyColor": "#c49ab4"
        },
        {
            "type": "terminal",
            "key": "└ └",
            "keyColor": "#c49ab4"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;143;184;158m└────────────────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;2;232;154;162m┌──────────────────\u001b[38;2;143;184;158mUptime / Age / DT\u001b[38;2;232;154;162m─────────────────┐"
        },
        {
            "type": "command",
            "key": " 󰃭 OS Age ",
            "keyColor": "#e89aa2",
            "text": "birth=$(stat -f %B / 2>/dev/null || stat -c %W / 2>/dev/null); now=$(date +%s); echo $(( (now - birth) / 86400 )) days"
        },
        {
            "type": "uptime",
            "key": "  Uptime ",
            "keyColor": "#e89aa2"
        },
        {
            "type": "datetime",
            "key": "  DateTime ",
            "keyColor": "#e89aa2"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;232;154;162m└────────────────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        },
        "break"
    ]
}
