{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "builtin",
        "source": "macos",
        "color": {
            "1": "#9a7a1f", // pale gold
            "2": "#8a5a7a", // mauve
            "3": "#b5474d", // Marluxia rose
            "4": "#46586f", // slate
            "5": "#3d7a7a"  // teal
        },
        "padding": {
            "top": 3,
            "left": 3
        }
    },
    "display": {
        "separator": ": ",
        "color": {
            "separator": "#8a8272"
        }
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;2;70;88;111m┌──────────────────────\u001b[38;2;154;122;31mHardware\u001b[38;2;70;88;111m──────────────────────┐"
        },
        {
            "type": "host",
            "key": " PC",
            "keyColor": "#46586f"
        },
        {
            "type": "cpu",
            "key": "│ ├",
            "keyColor": "#46586f"
        },
        {
            "type": "gpu",
            "key": "│ ├󰍛",
            "keyColor": "#46586f"
        },
        {
            "type": "memory",
            "key": "│ ├󰍛",
            "keyColor": "#46586f"
        },
        {
            "type": "disk",
            "key": "└ └",
            "keyColor": "#46586f",
            "folders": "/"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;70;88;111m└────────────────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;2;61;122;122m┌──────────────────────\u001b[38;2;154;122;31mSoftware\u001b[38;2;61;122;122m──────────────────────┐"
        },
        {
            "type": "os",
            "key": " OS",
            "keyColor": "#3d7a7a"
        },
        {
            "type": "kernel",
            "key": "│ ├",
            "keyColor": "#3d7a7a"
        },
        {
            "type": "packages",
            "key": "│ ├󰏖",
            "keyColor": "#3d7a7a"
        },
        {
            "type": "shell",
            "key": "└ └",
            "keyColor": "#3d7a7a"
        },
        "break",
        {
            "type": "wm",
            "key": " WM",
            "keyColor": "#8a5a7a"
        },
        {
            "type": "wmtheme",
            "key": "│ ├󰉼",
            "keyColor": "#8a5a7a"
        },
        {
            "type": "terminal",
            "key": "└ └",
            "keyColor": "#8a5a7a"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;61;122;122m└────────────────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;2;154;122;31m┌──────────────────\u001b[38;2;61;122;122mUptime / Age / DT\u001b[38;2;154;122;31m─────────────────┐"
        },
        {
            "type": "command",
            "key": " 󰃭 OS Age ",
            "keyColor": "#9a7a1f",
            "text": "birth=$(stat -f %B / 2>/dev/null || stat -c %W / 2>/dev/null); now=$(date +%s); echo $(( (now - birth) / 86400 )) days"
        },
        {
            "type": "uptime",
            "key": "  Uptime ",
            "keyColor": "#9a7a1f"
        },
        {
            "type": "datetime",
            "key": "  DateTime ",
            "keyColor": "#9a7a1f"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;154;122;31m└────────────────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        },
        "break"
    ]
}
