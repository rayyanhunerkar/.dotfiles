# swap with `scripts/set-theme.sh <name>` / `scripts/set-font.sh <name>`
# (config-file loads after this whole file, so these two win over anything below)
config-file = ?current-theme
config-file = ?current-font

# background-opacity / background-blur are set per-theme in themes/*, same as kitty.

# --- Window Layout ---
window-save-state = never
window-width      = 132
window-height     = 40
window-padding-x  = 20
window-padding-y  = 20

# Native fullscreen composites against black in its own Space, which makes
# transparency and blur read as solid. See the same note in kitty.conf.
macos-non-native-fullscreen = true

# --- Font Configuration ---
font-size          = 15
adjust-cell-height = 10%

# --- Cursor ---
cursor-style               = underline
cursor-style-blink         = false
shell-integration-features = no-cursor

# --- Mouse / Selection ---
copy-on-select = clipboard

# --- Shell ---
command = /bin/zsh --login -c "/opt/homebrew/bin/zellij"
# Back to tmux:
# command = /bin/zsh --login -c "/opt/homebrew/bin/tmux attach || /opt/homebrew/bin/tmux"

# --- Keyboard Shortcuts ---
# Left Option as Alt, matching kitty's default — zellij's Alt h/j/k/l need it
macos-option-as-alt = left

# Standard macOS word navigation
keybind = alt+left=esc:b
keybind = alt+right=esc:f

# Cmd + Backspace to delete line
keybind = cmd+backspace=text:\x15

# Font Resizing
keybind = cmd+equal=increase_font_size:2
keybind = cmd+minus=decrease_font_size:2
keybind = cmd+0=reset_font_size
