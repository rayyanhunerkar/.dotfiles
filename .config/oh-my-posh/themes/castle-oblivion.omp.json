{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "palette": {
    "bg": "#2b2b33",
    "fg": "#f0ede4",
    "blue": "#a8bcd4",
    "cyan": "#8fb89e",
    "gold": "#e89aa2",
    "pink": "#c49ab4",
    "red": "#f0787e",
    "dim": "#9a9284"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "path",
          "style": "diamond",
          "leading_diamond": "",
          "trailing_diamond": "",
          "foreground": "p:bg",
          "background": "p:gold",
          "properties": {
            "style": "folder"
          },
          "template": "  <b>{{ .Path }}</b> "
        },
        {
          "type": "git",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "p:bg",
          "background": "p:cyan",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:red{{ end }}"
          ],
          "properties": {
            "branch_icon": " ",
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "template": " {{ .HEAD }}{{ if gt .Behind 0 }} ↓{{ .Behind }}{{ end }}{{ if gt .Ahead 0 }} ↑{{ .Ahead }}{{ end }} "
        },
        {
          "type": "node",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "p:bg",
          "background": "p:blue",
          "properties": {
            "fetch_version": true,
            "home_enabled": false,
            "display_mode": "files"
          },
          "template": "  {{ .Full }} "
        },
        {
          "type": "python",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "p:bg",
          "background": "p:blue",
          "properties": {
            "fetch_version": true,
            "home_enabled": false,
            "display_mode": "files"
          },
          "template": "  {{ .Full }} "
        },
        {
          "type": "golang",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "p:bg",
          "background": "p:blue",
          "properties": {
            "fetch_version": true,
            "home_enabled": false,
            "display_mode": "files"
          },
          "template": "  {{ .Full }} "
        },
        {
          "type": "rust",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "p:bg",
          "background": "p:blue",
          "properties": {
            "fetch_version": true,
            "home_enabled": false,
            "display_mode": "files"
          },
          "template": "  {{ .Full }} "
        },
        {
          "type": "root",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "p:bg",
          "background": "p:red",
          "template": "  "
        },
        {
          "type": "executiontime",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "p:bg",
          "background": "p:pink",
          "properties": {
            "threshold": 2000,
            "style": "austin"
          },
          "template": " {{ .FormattedMs }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "status",
          "style": "plain",
          "foreground": "p:gold",
          "properties": {
            "always_enabled": true
          },
          "template": "{{ if .Error }}<p:red>{{ .Code }} ❯</>{{ else }}<p:gold>❯</>{{ end }}"
        }
      ]
    },
    {
      "type": "rprompt",
      "alignment": "right",
      "segments": [
        {
          "type": "time",
          "style": "plain",
          "foreground": "p:dim",
          "properties": {
            "time_format": "15:04"
          },
          "template": " {{ .CurrentDate | date .Format }}"
        }
      ]
    }
  ]
}
