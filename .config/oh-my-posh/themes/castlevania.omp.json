{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "palette": {
    "bg": "#120a10",
    "fg": "#efe3da",
    "accent": "#e8455a",
    "alt": "#7fa6d6",
    "warn": "#eeb04a",
    "bad": "#ff7a66",
    "good": "#7fb08a",
    "extra": "#a77fd1",
    "dim": "#8f7482",
    "line": "#3e2230"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "path",
          "style": "plain",
          "foreground": "p:fg",
          "properties": {
            "style": "folder"
          },
          "template": "<p:accent>†</> <b>{{ .Path }}</b>"
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "p:accent",
          "properties": {
            "branch_icon": "",
            "fetch_status": true
          },
          "template": " <p:line>──</> {{ .HEAD }}{{ if or (.Working.Changed) (.Staging.Changed) }}<p:warn> †</>{{ end }}<p:dim>{{ if gt .Behind 0 }} ↓{{ .Behind }}{{ end }}{{ if gt .Ahead 0 }} ↑{{ .Ahead }}{{ end }}</>"
        },
        {
          "type": "root",
          "style": "plain",
          "foreground": "p:bad",
          "template": " "
        },
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "p:dim",
          "properties": {
            "threshold": 2000,
            "style": "austin"
          },
          "template": " {{ .FormattedMs }}"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "status",
          "style": "plain",
          "foreground": "p:fg",
          "properties": {
            "always_enabled": true
          },
          "template": "{{ if .Error }}<p:bad>{{ .Code }} »</>{{ else }}<p:accent>»</>{{ end }}"
        }
      ]
    },
    {
      "type": "rprompt",
      "alignment": "right",
      "segments": [
        {
          "type": "node",
          "style": "plain",
          "foreground": "p:dim",
          "properties": {
            "fetch_version": true,
            "home_enabled": false,
            "display_mode": "files"
          },
          "template": "{{ .Full }} <p:line>·</> "
        },
        {
          "type": "python",
          "style": "plain",
          "foreground": "p:dim",
          "properties": {
            "fetch_version": true,
            "home_enabled": false,
            "display_mode": "files"
          },
          "template": "{{ .Full }} <p:line>·</> "
        },
        {
          "type": "golang",
          "style": "plain",
          "foreground": "p:dim",
          "properties": {
            "fetch_version": true,
            "home_enabled": false,
            "display_mode": "files"
          },
          "template": "{{ .Full }} <p:line>·</> "
        },
        {
          "type": "rust",
          "style": "plain",
          "foreground": "p:dim",
          "properties": {
            "fetch_version": true,
            "home_enabled": false,
            "display_mode": "files"
          },
          "template": "{{ .Full }} <p:line>·</> "
        },
        {
          "type": "time",
          "style": "plain",
          "foreground": "p:dim",
          "properties": {
            "time_format": "15:04"
          },
          "template": "{{ .CurrentDate | date .Format }}"
        }
      ]
    }
  ]
}
