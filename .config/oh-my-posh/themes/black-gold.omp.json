{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "palette": {
    "bg": "#000000",
    "fg": "#f5ecd6",
    "accent": "#d4af37",
    "alt": "#f5d76e",
    "warn": "#ff9f1c",
    "bad": "#e5484d",
    "good": "#a3b86c",
    "extra": "#dba392",
    "dim": "#8a7a52",
    "line": "#332a14"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "path",
          "style": "plain",
          "foreground": "p:bg",
          "properties": {
            "style": "folder"
          },
          "template": " <b>{{ .Path }}</b> ",
          "background": "p:accent"
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "p:accent",
          "properties": {
            "branch_icon": "",
            "fetch_status": true
          },
          "template": " {{ .HEAD }}{{ if or (.Working.Changed) (.Staging.Changed) }}<p:warn> ●</>{{ end }}<p:dim>{{ if gt .Behind 0 }} ↓{{ .Behind }}{{ end }}{{ if gt .Ahead 0 }} ↑{{ .Ahead }}{{ end }}</>"
        },
        {
          "type": "root",
          "style": "plain",
          "foreground": "p:bad",
          "template": " "
        },
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "p:dim",
          "properties": {
            "threshold": 2000,
            "style": "austin"
          },
          "template": " {{ .FormattedMs }}"
        },
        {
          "type": "status",
          "style": "plain",
          "foreground": "p:fg",
          "properties": {
            "always_enabled": true
          },
          "template": " {{ if .Error }}<p:bad>{{ .Code }} ▸</>{{ else }}<p:accent>▸</>{{ end }}"
        }
      ]
    },
    {
      "type": "rprompt",
      "alignment": "right",
      "segments": [
        {
          "type": "node",
          "style": "plain",
          "foreground": "p:dim",
          "properties": {
            "fetch_version": true,
            "home_enabled": false,
            "display_mode": "files"
          },
          "template": "{{ .Full }} <p:line>·</> "
        },
        {
          "type": "python",
          "style": "plain",
          "foreground": "p:dim",
          "properties": {
            "fetch_version": true,
            "home_enabled": false,
            "display_mode": "files"
          },
          "template": "{{ .Full }} <p:line>·</> "
        },
        {
          "type": "golang",
          "style": "plain",
          "foreground": "p:dim",
          "properties": {
            "fetch_version": true,
            "home_enabled": false,
            "display_mode": "files"
          },
          "template": "{{ .Full }} <p:line>·</> "
        },
        {
          "type": "rust",
          "style": "plain",
          "foreground": "p:dim",
          "properties": {
            "fetch_version": true,
            "home_enabled": false,
            "display_mode": "files"
          },
          "template": "{{ .Full }} <p:line>·</> "
        },
        {
          "type": "time",
          "style": "plain",
          "foreground": "p:dim",
          "properties": {
            "time_format": "15:04"
          },
          "template": "{{ .CurrentDate | date .Format }}"
        }
      ]
    }
  ]
}
