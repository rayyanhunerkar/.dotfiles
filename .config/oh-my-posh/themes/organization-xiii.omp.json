{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "palette": {
    "bg": "#0b0b0d",
    "fg": "#e8e8ec",
    "blue": "#2e5c8a",
    "cyan": "#7fb0c9",
    "gold": "#b8bcc4",
    "pink": "#6a6a75",
    "red": "#c8102e",
    "dim": "#6a6a75"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "path",
          "style": "plain",
          "foreground": "p:gold",
          "properties": {
            "style": "folder"
          },
          "template": "<b>{{ .Path }}</b>"
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "p:cyan",
          "properties": {
            "branch_icon": "",
            "fetch_status": true
          },
          "template": " <p:dim>—</> {{ .HEAD }}{{ if or (.Working.Changed) (.Staging.Changed) }}<p:red> ·</>{{ end }}{{ if gt .Behind 0 }}<p:dim> ↓{{ .Behind }}</p:dim>{{ end }}{{ if gt .Ahead 0 }}<p:dim> ↑{{ .Ahead }}</p:dim>{{ end }}"
        },
        {
          "type": "node",
          "style": "plain",
          "foreground": "p:dim",
          "properties": {
            "fetch_version": true,
            "home_enabled": false,
            "display_mode": "files"
          },
          "template": " <p:dim>—</> {{ .Full }}"
        },
        {
          "type": "python",
          "style": "plain",
          "foreground": "p:dim",
          "properties": {
            "fetch_version": true,
            "home_enabled": false,
            "display_mode": "files"
          },
          "template": " <p:dim>—</> {{ .Full }}"
        },
        {
          "type": "golang",
          "style": "plain",
          "foreground": "p:dim",
          "properties": {
            "fetch_version": true,
            "home_enabled": false,
            "display_mode": "files"
          },
          "template": " <p:dim>—</> {{ .Full }}"
        },
        {
          "type": "rust",
          "style": "plain",
          "foreground": "p:dim",
          "properties": {
            "fetch_version": true,
            "home_enabled": false,
            "display_mode": "files"
          },
          "template": " <p:dim>—</> {{ .Full }}"
        },
        {
          "type": "root",
          "style": "plain",
          "foreground": "p:red",
          "template": " <p:red>— root</>"
        },
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "p:dim",
          "properties": {
            "threshold": 2000,
            "style": "austin"
          },
          "template": " <p:dim>— {{ .FormattedMs }}</>"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "status",
          "style": "plain",
          "foreground": "p:cyan",
          "properties": {
            "always_enabled": true
          },
          "template": "{{ if .Error }}<p:red>{{ .Code }} »</>{{ else }}<p:cyan>»</>{{ end }}"
        }
      ]
    },
    {
      "type": "rprompt",
      "alignment": "right",
      "segments": [
        {
          "type": "time",
          "style": "plain",
          "foreground": "p:dim",
          "properties": {
            "time_format": "15:04"
          },
          "template": " {{ .CurrentDate | date .Format }}"
        }
      ]
    }
  ]
}
