{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "palette": {
    "bg": "#0c0e14",
    "fg": "#e9edf2",
    "accent": "#6fa3d8",
    "alt": "#8fe3dc",
    "warn": "#f08a3c",
    "bad": "#d8524f",
    "good": "#7fb88a",
    "extra": "#a48fd0",
    "dim": "#6d7890",
    "line": "#2a3040"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "path",
          "style": "plain",
          "foreground": "p:fg",
          "properties": {
            "style": "folder"
          },
          "template": "<b>{{ .Path }}</b>"
        },
        {
          "type": "root",
          "style": "plain",
          "foreground": "p:bad",
          "template": " "
        },
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "p:dim",
          "properties": {
            "threshold": 2000,
            "style": "austin"
          },
          "template": " {{ .FormattedMs }}"
        },
        {
          "type": "status",
          "style": "plain",
          "foreground": "p:fg",
          "properties": {
            "always_enabled": true
          },
          "template": " {{ if .Error }}<p:bad>{{ .Code }} ◆</>{{ else }}<p:fg>◆</>{{ end }}"
        }
      ]
    },
    {
      "type": "rprompt",
      "alignment": "right",
      "segments": [
        {
          "type": "git",
          "style": "plain",
          "foreground": "p:accent",
          "properties": {
            "branch_icon": "",
            "fetch_status": true
          },
          "template": "{{ .HEAD }}{{ if or (.Working.Changed) (.Staging.Changed) }}<p:warn> ◆</>{{ end }}<p:dim>{{ if gt .Behind 0 }} ↓{{ .Behind }}{{ end }}{{ if gt .Ahead 0 }} ↑{{ .Ahead }}{{ end }}</> "
        },
        {
          "type": "node",
          "style": "plain",
          "foreground": "p:dim",
          "properties": {
            "fetch_version": true,
            "home_enabled": false,
            "display_mode": "files"
          },
          "template": "<p:line>·</> {{ .Full }} "
        },
        {
          "type": "python",
          "style": "plain",
          "foreground": "p:dim",
          "properties": {
            "fetch_version": true,
            "home_enabled": false,
            "display_mode": "files"
          },
          "template": "<p:line>·</> {{ .Full }} "
        },
        {
          "type": "golang",
          "style": "plain",
          "foreground": "p:dim",
          "properties": {
            "fetch_version": true,
            "home_enabled": false,
            "display_mode": "files"
          },
          "template": "<p:line>·</> {{ .Full }} "
        },
        {
          "type": "rust",
          "style": "plain",
          "foreground": "p:dim",
          "properties": {
            "fetch_version": true,
            "home_enabled": false,
            "display_mode": "files"
          },
          "template": "<p:line>·</> {{ .Full }} "
        },
        {
          "type": "time",
          "style": "plain",
          "foreground": "p:dim",
          "properties": {
            "time_format": "15:04"
          },
          "template": "<p:line>·</> {{ .CurrentDate | date .Format }}"
        }
      ]
    }
  ]
}
