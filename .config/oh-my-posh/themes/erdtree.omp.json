{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "palette": {
    "bg": "#14100c",
    "fg": "#e8dcc0",
    "blue": "#d4a437",
    "cyan": "#5aa8b8",
    "gold": "#e8c56a",
    "pink": "#8a6a9a",
    "red": "#b83232",
    "dim": "#7a6b52",
    "moss": "#7a8a52"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:dim",
          "template": "╭─"
        },
        {
          "type": "path",
          "style": "plain",
          "foreground": "p:blue",
          "properties": {
            "style": "agnoster_short",
            "max_depth": 3
          },
          "template": "<p:gold>  </><b>{{ .Path }}</b>"
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "p:cyan",
          "properties": {
            "branch_icon": " ",
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "template": " <p:dim>─</> {{ .HEAD }}{{ if or (.Working.Changed) (.Staging.Changed) }}<p:gold> </>{{ end }}{{ if gt .Behind 0 }}<p:pink> ↓{{ .Behind }}</p:pink>{{ end }}{{ if gt .Ahead 0 }}<p:pink> ↑{{ .Ahead }}</p:pink>{{ end }}"
        },
        {
          "type": "node",
          "style": "plain",
          "foreground": "p:moss",
          "properties": {
            "fetch_version": true,
            "home_enabled": false,
            "display_mode": "files"
          },
          "template": " <p:dim>─</>  {{ .Full }}"
        },
        {
          "type": "python",
          "style": "plain",
          "foreground": "p:moss",
          "properties": {
            "fetch_version": true,
            "home_enabled": false,
            "display_mode": "files"
          },
          "template": " <p:dim>─</>  {{ .Full }}"
        },
        {
          "type": "golang",
          "style": "plain",
          "foreground": "p:moss",
          "properties": {
            "fetch_version": true,
            "home_enabled": false,
            "display_mode": "files"
          },
          "template": " <p:dim>─</>  {{ .Full }}"
        },
        {
          "type": "rust",
          "style": "plain",
          "foreground": "p:moss",
          "properties": {
            "fetch_version": true,
            "home_enabled": false,
            "display_mode": "files"
          },
          "template": " <p:dim>─</>  {{ .Full }}"
        },
        {
          "type": "root",
          "style": "plain",
          "foreground": "p:red",
          "template": " <p:dim>─</> "
        },
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "p:dim",
          "properties": {
            "threshold": 2000,
            "style": "austin"
          },
          "template": " <p:dim>─  {{ .FormattedMs }}</>"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "status",
          "style": "plain",
          "foreground": "p:gold",
          "properties": {
            "always_enabled": true
          },
          "template": "<p:dim>╰─</>{{ if .Error }}<p:red>{{ .Code }} ❯</>{{ else }}<p:gold>❯</>{{ end }}"
        }
      ]
    },
    {
      "type": "rprompt",
      "alignment": "right",
      "segments": [
        {
          "type": "time",
          "style": "plain",
          "foreground": "p:dim",
          "properties": {
            "time_format": "15:04"
          },
          "template": " {{ .CurrentDate | date .Format }}"
        }
      ]
    }
  ]
}
